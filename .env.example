# Email Notification Configuration (Optional)
# If provided, new contact form inquiries will be sent directly via Gmail SMTP.
# Otherwise, inquiries are automatically forwarded to muhammadkamran0774@gmail.com and saved in the database at /inbox.

RECIPIENT_EMAIL=muhammadkamran0774@gmail.com

# To send from your own Gmail account directly:
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create a 16-character App Password (e.g. "abcd efgh ijkl mnop")
# 4. Paste your email and app password below in .env.local:
# EMAIL_USER=muhammadkamran0774@gmail.com
# EMAIL_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com

# Protected Inbox Access PIN (Default is 1234)
INBOX_ACCESS_PIN=1234
